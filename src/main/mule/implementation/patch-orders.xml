<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:db="http://www.mulesoft.org/schema/mule/db"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"

	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd 
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
http://www.mulesoft.org/schema/mule/core 
http://www.mulesoft.org/schema/mule/core/current/mule.xsd">


	<sub-flow name="patch-orders-sub-flow">


		<logger
			level="INFO"
			doc:name="Log PATCH Orders Request"

			message='#[%dw 2.0
output application/json
---
{
	appName: app.name,
	flowName: flow.name,
	message: "PATCH orders request received.",
	correlationId: vars.correlationId,
	timestamp: now()
}]'/>

		<set-variable value="#[payload]" doc:name="var: requestPayload" doc:id="12bb9e0f-e7c9-4dcd-97b8-133ff70798a6" variableName="requestPayload"/>
		<!-- [STUDIO:"Fetch Order Data"]<db:select doc:name="Fetch Order Data" doc:id="fd8f53c2-0d43-4fd5-833d-1eee294a34fa" config-ref="orders-db-configuration">
			<db:sql><![CDATA[SELECT
    orderId,
    orderPlacedAt,
    orderCancelledAt,
    syncStatus
	FROM ordersStaging
	WHERE orderId = :orderId
			&#93;&#93;></db:sql>

    <db:input-parameters><![CDATA[#[{
        orderId: vars.requestPayload.orderId
    }&#93;&#93;&#93;></db:input-parameters>
    
		</db:select> [STUDIO] -->
		<!-- [STUDIO:"var: existingOrder"]<set-variable value="#[payload[0&#93;&#93;" doc:name="var: existingOrder" doc:id="9d41ac4d-a5a7-4ac0-988e-0761730c150f" variableName="existingOrder"/> [STUDIO] -->
		<!-- [STUDIO:"durationInBetween?"]<choice doc:name="durationInBetween?" doc:id="479f5918-7dee-47c3-807c-45c94f830df5" >
			<when expression='#[%dw 2.0&#10;output application/java&#10;&#10;var placedAt =&#10;    if(vars.existingOrder.orderPlacedAt != null)&#10;        vars.existingOrder.orderPlacedAt as DateTime&#10;    else&#10;        null&#10;&#10;var cancelledAt =&#10;    if(vars.requestPayload.orderCancelledAt != null)&#10;        vars.requestPayload.orderCancelledAt as DateTime&#10;    else&#10;        null&#10;&#10;var diffHours =&#10;    if(placedAt != null and cancelledAt != null)&#10;        durationBetween(placedAt, cancelledAt).hours&#10;    else&#10;        9&#10;&#10;&#45;&#45;-&#10;(vars.requestPayload.status == "CANCELLED")&#10;and&#10;(diffHours &lt; 6)&#93;'>
				<set-variable value="SKIPPED" doc:name="var: syncStatus" doc:id="28453c26-e92d-4874-8374-6bb9f44a41b9" variableName="syncStatus"/>
			</when>
			<otherwise >
				<set-variable
    				value="#[vars.requestPayload.syncStatus&#93;"
    				variableName="syncStatus" doc:name="var: syncStatus"/>
			</otherwise>
		</choice> [STUDIO] -->
		<db:update
			config-ref="orders-db-configuration"
			doc:name="Update Order Sync Status">

			<db:sql><![CDATA[UPDATE ordersStaging
SET
    syncStatus = :syncStatus,
    syncMessage = :syncMessage,
    salesforceId = :salesforceId,
    updatedAt = NOW()
WHERE orderId = :orderId]]></db:sql>


			<db:input-parameters><![CDATA[#[[{
    syncStatus: vars.requestPayload.syncStatus,

    syncMessage: vars.requestPayload.syncMessage,

    salesforceId:
        if(vars.requestPayload.salesforceId != null)
            vars.requestPayload.salesforceId
        else
            null,

    orderId: vars.requestPayload.orderId
}]]]]></db:input-parameters>

		</db:update>


		<choice doc:name="isRowUpdated?">

			<when expression="#[payload.affectedRows == 0]">

				<set-variable
					variableName="httpStatus"
					value="404"
					doc:name="var: httpStatus 404"/>


				<ee:transform doc:name="Preparing Order Not Found Response">

					<ee:message>
						<ee:set-payload resource="dwl/p_orderNotFound.dwl" />

					</ee:message>

				</ee:transform>


				<logger
					level="INFO"
					doc:name="Order Not Found Response"

					message='#[%dw 2.0
output application/json
---
{
	appName: app.name,
	flowName: flow.name,
	message: "PATCH failed. Order not found.",
	correlationId: vars.correlationId,
	timestamp: now()
}]'/>

			</when>

			<otherwise>

				<set-variable
					variableName="httpStatus"
					value="200"
					doc:name="var: httpStatus 200"/>


				<ee:transform doc:name="Preparing Patch Orders Response">

					<ee:message>

						<ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
	success: true,
	message: "Orders sync status updated successfully.",
	correlationId: vars.correlationId,
	timestamp: now()
}
]]></ee:set-payload>

					</ee:message>

				</ee:transform>


				<logger
					level="INFO"
					doc:name="Patch Orders Response Sent"

					message='#[%dw 2.0
output application/json
---
{
	appName: app.name,
	flowName: flow.name,
	message: "PATCH orders response sent successfully.",
	correlationId: vars.correlationId,
	timestamp: now()
}]'/>

			</otherwise>

		</choice>


	</sub-flow>

</mule>